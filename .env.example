# Saudade · environment (copy to .env.local; never commit real values). Setup guide: docs/BACKEND.md

# ── Which data layer the screens use ─────────────────────────────────────────
# "mock"  = the in-browser prototype (default; no backend needed; the Demo Panel works)
# "api"   = the real backend below (Supabase). Rebuild / restart the dev server after changing.
NEXT_PUBLIC_DATA_SOURCE=api

# ── Supabase (Project settings) ──────────────────────────────────────────────
# API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# API → service_role key. SERVER ONLY: never prefix with NEXT_PUBLIC_, never paste into chat.
SUPABASE_SERVICE_ROLE_KEY=
# Database → Connection pooling → Transaction mode (port 6543), with your database password filled in.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Private bucket for photos and voice notes (created by `npm run db:setup`).
SUPABASE_MEDIA_BUCKET=media

# ── Secrets (generated by `npm run db:setup` if left empty) ──────────────────
# 32 random bytes as 64 hex chars. CODE_PEPPER_V1 must be escrowed: losing it voids every unclaimed card.
CODE_PEPPER_V1=
IP_HASH_KEY=

# ── Admin sign-in (created/updated by `npm run db:setup`) ────────────────────
ADMIN_EMAIL=zeya@saudade.example
# Generated if empty. Use at least 14 characters if you set it yourself.
ADMIN_PASSWORD=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without a key, emails are recorded in the admin log but not delivered.
# Resend needs a verified sending domain (O2) before it can email customers.
RESEND_API_KEY=
EMAIL_FROM=Saudade <letters@saudade.example>
# Origin used in emailed links; defaults to the address the site is opened on.
PUBLIC_APP_ORIGIN=
