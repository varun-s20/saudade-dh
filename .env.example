# Saudade · environment (copy to .env.local; never commit real values).
# Setup: docs/BACKEND.md · every variable explained: docs/HANDOVER.md §4 · `npm run launch:check -- --env-file <file>`
# flags anything still missing.

# ── Which data layer the screens use ─────────────────────────────────────────
# "mock"  = the in-browser prototype (default; no backend needed; the Demo Panel works)
# "api"   = the real backend below (Supabase). Rebuild / restart the dev server after changing.
NEXT_PUBLIC_DATA_SOURCE=api

# ── Deployment settings (NEXT_PUBLIC_*: baked in at build time, so rebuild after changing) ──
# The domain written on every NFC chip, e.g. saudade.gift. PERMANENT once chips are encoded (O2).
# Unset = the placeholder saudade.example (fine for demos, never for a production batch).
NEXT_PUBLIC_CHIP_DOMAIN=
# Shown on the pages for help.
NEXT_PUBLIC_SUPPORT_EMAIL=
# 1 = after sealing, show the sender the address the heart opens (demos without a ceramic). 0 for launch.
NEXT_PUBLIC_SHOW_RECIPIENT_LINK=1

# ── Supabase (Project settings) ──────────────────────────────────────────────
# API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# API → service_role key. SERVER ONLY: never prefix with NEXT_PUBLIC_, never paste into chat.
SUPABASE_SERVICE_ROLE_KEY=
# Database → Connection pooling → Transaction mode (port 6543), with your database password filled in.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Private bucket for photos and voice notes (created by `npm run db:setup`).
SUPABASE_MEDIA_BUCKET=media

# ── Secrets (generated by `npm run db:setup` if left empty) ──────────────────
# 32 random bytes as 64 hex chars. CODE_PEPPER_V1 must be escrowed: losing it voids every unclaimed card.
CODE_PEPPER_V1=
IP_HASH_KEY=

# ── Admin sign-in (created/updated by `npm run db:setup`; more admins: `npm run admin -- add <email>`) ──
ADMIN_EMAIL=zeya@saudade.example
# Generated if empty. Use at least 14 characters if you set it yourself.
ADMIN_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# Without a key, emails are recorded in the admin log but not delivered.
# Resend needs a verified sending domain (O2) before it can email customers.
RESEND_API_KEY=
EMAIL_FROM=Saudade <letters@saudade.example>
# Origin used in emailed links, e.g. https://saudade.gift. Defaults to the address the site is opened on.
PUBLIC_APP_ORIGIN=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends it to /api/cron/* (vercel.json); the nightly backup workflow reports with it.
# Unset = the nightly jobs (clean-up, song checks, media retries) refuse to run.
CRON_SECRET=jw4XkqHGA1AKYs3wbYxm0voPqZtGGsN7

# ── Bot check for the claim page (optional, Cloudflare Turnstile) ────────────
# Only used if mass code-guessing trips the breaker: then every claim passes a quiet check for 6 hours
# instead of all claims pausing for up to an hour.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rarely needed ────────────────────────────────────────────────────────────
# A specific ffmpeg binary for voice transcoding (default: the one bundled by the ffmpeg-static package).
FFMPEG_PATH=
